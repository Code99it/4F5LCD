			"contents": "// menu.c\n#include \"menu.h\"\n#include <string.h>\n#include <stdio.h>\n#include \"font.h\"\n#include \"lcd.h\"\n#include \"color.h\"\n\n// Menü-Sprache (Definition)\nint current_language = LANGUAGE_DE;\n\n// Menüeinträge\nconst char *menuitems[3][MENUITEM_COUNT] = {\n    { \"BC1\", \"BC2\", \"Setup\",      \"Trip\",  \"Rennen\", \"Runde\",     \"Turbo\", \"GPS\", \"Check\",    \"Telefon\" },\n    { \"BC1\", \"BC2\", \"Setup\",      \"Trip\",  \"Race\",   \"Lap\",       \"Turbo\", \"GPS\", \"Check\",    \"Phone\" },\n    { \"BC1\", \"BC2\", \"Ustawienia\", \"Trasa\", \"Wyścig\", \"Okrążenie\", \"Turbo\", \"GPS\", \"Kontrola\", \"Telefon\" }\n};\n\n// Framebuffer für die gesamte Menüzeile\nuint16_t frmbuf_menubar[MENUBAR_HEIGHT][MENUFRAMEBUFFER_WIDTH];\n\n// Scroll-Offsets für zentrierte Anzeige jedes Menüeintrags\nint16_t menuitem_scroll_offsets[MENUITEM_COUNT];\n\n// Zeichnet alle Menüeinträge nebeneinander in den Framebuffer\nvoid draw_menu_to_buffer(const char *menu[], uint32_t hex_color, uint8_t font_size) {\n    printf(\"[DEBUG] Size of frmbuf_menubar: %zu bytes\\n\", sizeof(frmbuf_menubar));\n    memset(frmbuf_menubar, 0, sizeof(frmbuf_menubar));\n\n    uint16_t x_cursor = 0;\n\n    for (int i = 0; i < MENUITEM_COUNT; i++) {\n        const char *item = menu[i];\n        uint16_t x = x_cursor;\n        uint16_t y = 0;\n\n        printf(\"[MENU] Zeichne Eintrag %d: '%s'\\n\", i, item);\n\n        while (*item) {\n            const FontGlyph *glyph = NULL;\n\n            switch (font_size) {\n                case 24: glyph = &outfit24_glyphs[(uint8_t)*item]; break;\n                case 29: glyph = &outfit29_glyphs[(uint8_t)*item]; break;\n                case 36: glyph = &outfit36_glyphs[(uint8_t)*item]; break;\n            }\n\n            if (!glyph || !glyph->data) {\n                printf(\"[FEHLER] Kein Glyph für '%c' (ASCII %d)\\n\", *item, *item);\n            } else {\n                printf(\"[GLYPH] '%c': w=%d, h=%d, first pixel=0x%04X\\n\", *item, glyph->width, glyph->height, glyph->data[0]);\n\n                for (int row = 0; row < glyph->height; row++) {\n                    for (int col = 0; col < glyph->width; col++) {\n                        uint16_t pixel = glyph->data[row * glyph->width + col];\n\n                        int draw_x = x + col;\n                        int draw_y = y + row;\n\n                        if (draw_x < MENUFRAMEBUFFER_WIDTH && draw_y < MENUBAR_HEIGHT) {\n                            frmbuf_menubar[draw_y][draw_x] = pixel;\n                        }\n                    }\n                }\n                x += glyph->width + FONT_LETTER_SPACING_PX;\n            }\n            item++;\n        }\n\n        // Nächsten Eintrag nach Abstand setzen\n        x_cursor = x + MENUITEM_SPACING;\n    }\n}\n\n// Zeichnet einen 320px breiten Ausschnitt des Framebuffers auf das LCD\nvoid lcd_draw_menubar_region(int32_t start_x) {\n\n    if (start_x < 0) {\n        printf(\"[WARN] start_x negativ! Setze auf 0.\\n\");\n        start_x = 0;\n    }\n\n    if (start_x > MENUFRAMEBUFFER_WIDTH - LCD_PIXEL_WIDTH) {\n        printf(\"[WARN] start_x zu groß! Begrenze auf max gültig.\\n\");\n        start_x = MENUFRAMEBUFFER_WIDTH - LCD_PIXEL_WIDTH;\n    }\n\n    for (int y = 0; y < MENUBAR_HEIGHT; y++) {\n        lcd_set_address_window(0, y + MENUBAR_Y_OFFSET, LCD_PIXEL_WIDTH - 1, y + MENUBAR_Y_OFFSET);\n        for (int x = 0; x < LCD_PIXEL_WIDTH; x++) {\n            uint16_t pixel = frmbuf_menubar[y][start_x + x];\n\n            lcd_write_data(pixel >> 8);    // High byte zuerst\n            lcd_write_data(pixel & 0xFF);  // Dann low byte\n        }\n    }\n}\n\n\n\n// DEBUG:\n/*void lcd_draw_menubar_region(uint16_t start_x) {\n    printf(\"[TEST] Zeichne 320x29 direkt in ROT (StartX ignoriert)\\n\");\n\n    uint16_t pixel = 0xF800;  // Rot in RGB565 (1111100000000000)\n\n    for (int y = 0; y < MENUBAR_HEIGHT; y++) {\n        lcd_set_address_window(0, y, LCD_PIXEL_WIDTH - 1, y);\n        for (int x = 0; x < LCD_PIXEL_WIDTH; x++) {\n            lcd_write_data(pixel >> 8);    // MSB (0xF8)\n            lcd_write_data(pixel & 0xFF);  // LSB (0x00)\n        }\n    }\n}*/\n\n\n\n\n\n// Berechnet für jeden Menüeintrag den Offset, bei dem er mittig im LCD erscheint\nvoid calculate_menu_scroll_offsets(const char *menu[], uint8_t font_size) {\n    uint16_t x_cursor = 0;\n\n    for (int i = 0; i < MENUITEM_COUNT; i++) {\n        const char *text = menu[i];\n        uint16_t total_width = 0;\n        const char *ptr = text;\n\n        printf(\"[OFFSET] Berechne für '%s'\\n\", text);\n\n        while (*ptr) {\n            const FontGlyph *glyph = NULL;\n            switch (font_size) {\n                case 24: glyph = &outfit24_glyphs[(uint8_t)*ptr]; break;\n                case 29: glyph = &outfit29_glyphs[(uint8_t)*ptr]; break;\n                case 36: glyph = &outfit36_glyphs[(uint8_t)*ptr]; break;\n            }\n\n            if (glyph && glyph->data) {\n                total_width += glyph->width + FONT_LETTER_SPACING_PX;\n            } else {\n                printf(\"[FEHLER] Kein Glyph für '%c' in Offset-Berechnung\\n\", *ptr);\n            }\n            ptr++;\n        }\n        if (total_width > 0) {\n            total_width -= FONT_LETTER_SPACING_PX; // Letztes Spacing entfernen\n        }\n\n        menuitem_scroll_offsets[i] = x_cursor + (total_width / 2) - (LCD_PIXEL_WIDTH / 2);\n        printf(\"[OFFSET] menuitem_scroll_offsets[%d] = %u\\n\", i, menuitem_scroll_offsets[i]);\n\n        x_cursor += total_width + MENUITEM_SPACING;\n    }\n}\n\n// Initialisiert das Menü\nvoid init_menu(uint32_t color, uint8_t font_size) {\n    printf(\"[INIT] Menüinitialisierung (Farbe: 0x%08lX, Schriftgröße: %d)\\n\", (unsigned long)color, font_size);\n    draw_menu_to_buffer(menuitems[current_language], color, font_size);\n    calculate_menu_scroll_offsets(menuitems[current_language], font_size);\n}\n",
